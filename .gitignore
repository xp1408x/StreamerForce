npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Dependencias
/node_modules
/.pnp
.pnp.js

# Next.js build
/.next/
/out/
/build

# Variables de entorno (¡MUY IMPORTANTE!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local


# Sistema
.DS_Store
Thumbs.db

# Supabase local (opcional si usas CLI)
/supabase/.temp
/supabase/pull

# Scripts de base de datos - Evitar subir backups con datos reales
/script/*.backup
/script/*.data.sql